# Smokeball MCP — environment variables
# Copy to ~/.smokeball-mcp/.env and fill in your values.
# oauth_flow.py writes this file automatically during setup.

SMOKEBALL_CLIENT_ID=your_client_id_here
SMOKEBALL_CLIENT_SECRET=your_client_secret_here
SMOKEBALL_API_KEY=your_api_key_here
SMOKEBALL_REGION=us
